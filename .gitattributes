# Ensure consistent line endings across platforms
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf

# Generated structured data and site sources
*.json text eol=lf
*.py text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.css text eol=lf
*.html text eol=lf

# Preserve downloaded evidence bytes; do not lint snapshot whitespace
extensions/professions/sources/** -text -whitespace
extensions/professions/audit/** -whitespace
