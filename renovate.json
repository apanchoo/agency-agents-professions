{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "timezone": "Europe/Paris",
  "labels": [
    "dependencies"
  ],
  "enabledManagers": [
    "npm",
    "pip_requirements",
    "github-actions"
  ],
  "rangeStrategy": "pin",
  "minimumReleaseAge": "3 days",
  "prHourlyLimit": 4,
  "prConcurrentLimit": 5,
  "platformAutomerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "packageRules": [
    {
      "matchUpdateTypes": [
        "patch",
        "minor",
        "digest",
        "pin"
      ],
      "automerge": true
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "matchPackageNames": [
        "@docusaurus/core",
        "@docusaurus/preset-classic"
      ],
      "groupName": "Docusaurus"
    },
    {
      "matchPackageNames": [
        "react",
        "react-dom"
      ],
      "groupName": "React"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": true
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": [
      "at any time"
    ],
    "minimumReleaseAge": "0 days"
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "schedule": [
    "before 6am"
  ]
}
